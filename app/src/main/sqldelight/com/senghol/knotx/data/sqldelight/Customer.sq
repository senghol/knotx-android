-- Saved customer ("Bill to") details, one row per contact (keyed by contactId).

CREATE TABLE customer (
    contact_id TEXT NOT NULL PRIMARY KEY,
    name       TEXT NOT NULL DEFAULT '',
    gst        TEXT NOT NULL DEFAULT '',
    phone      TEXT NOT NULL DEFAULT '',
    email      TEXT NOT NULL DEFAULT '',
    address    TEXT NOT NULL DEFAULT '',
    updated_at INTEGER NOT NULL DEFAULT 0
);

getCustomer:
SELECT * FROM customer WHERE contact_id = :contactId;

upsertCustomer:
INSERT OR REPLACE INTO customer(contact_id, name, gst, phone, email, address, updated_at)
VALUES (:contactId, :name, :gst, :phone, :email, :address, :updatedAt);

getAllCustomers:
SELECT * FROM customer ORDER BY name COLLATE NOCASE, contact_id;

deleteCustomer:
DELETE FROM customer WHERE contact_id = :contactId;